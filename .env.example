# Copy this file to ".env" in the project root and fill in real values.
# NEVER commit the real ".env" file to version control.

# ------------------------------------------------------------------
# Instagram Graph API (required for live Instagram post retrieval)
# Requires a Facebook Business/App + Instagram Business/Creator account
# linked to a Facebook Page. See README.md "Required API Permissions".
# ------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------------
# Public Holiday / Calendar data source (optional)
# ------------------------------------------------------------------
CALENDARIFIC_API_KEY=

# ------------------------------------------------------------------
# Microsoft 365 / Outlook / Teams (optional - for reminder delivery)
# ------------------------------------------------------------------
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_SENDER_EMAIL=
MS_TEAMS_WEBHOOK_URL=

# ------------------------------------------------------------------
# Google Calendar (optional - alternative reminder delivery)
# ------------------------------------------------------------------
GOOGLE_CALENDAR_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_FILE=
