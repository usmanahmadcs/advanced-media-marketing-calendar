# Copy this file to ".env" in the project root and fill in real values.
# NEVER commit the real ".env" file to version control.

# ------------------------------------------------------------------
# Instagram Graph API (required for live Instagram post retrieval)
# Requires a Facebook Business/App + Instagram Business/Creator account
# linked to a Facebook Page. See README.md "Required API Permissions".
# ------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------------
# Public Holiday / Calendar data source (optional - used if you want
# live holiday lookups instead of/in addition to the seed dataset)
# Example provider: Calendarific (https://calendarific.com/)
# ------------------------------------------------------------------
CALENDARIFIC_API_KEY=

# ------------------------------------------------------------------
# Microsoft 365 / Outlook / Teams (optional - for reminder delivery)
# Requires an Azure AD App Registration with Mail.Send / Calendars.ReadWrite
# and ChannelMessage.Send (delegated or application permissions).
# ------------------------------------------------------------------
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_SENDER_EMAIL=
MS_TEAMS_WEBHOOK_URL=

# ------------------------------------------------------------------
# Google Calendar (optional - alternative reminder delivery)
# Requires a Google Cloud project with Calendar API enabled and an
# OAuth Client ID (Desktop app type) JSON file downloaded from
# Google Cloud Console. See README.md section 4.3.1 for full setup.
# GOOGLE_CALENDAR_TOKEN_FILE is optional; defaults to
# config/google_token.json (auto-created after the first login).
# ------------------------------------------------------------------
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_FILE=
